# PREUVIA DUERP - Variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs

# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/preuvia_duerp"

# NextAuth.js
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optionnel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (paiements) - clés de TEST uniquement (sk_test_/whsec_ de test)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Payment Links Stripe officiels et IMMUABLES (voir STRIPE_PAYMENT_LINKS.md).
# Configuration publique : valeurs par défaut déjà correctes dans
# lib/billing/plans.ts, ne renseigner ici que pour un environnement de test
# dédié pointant vers d'autres Payment Links de test.
STRIPE_PAYMENT_LINK_ESSENTIEL="https://buy.stripe.com/7sYbJ15FA2J75RMeQy5os00"
STRIPE_PAYMENT_LINK_PILOTAGE="https://buy.stripe.com/eVq28r1pkfvTeoi37Q5os01"
STRIPE_PAYMENT_LINK_MAITRISE="https://buy.stripe.com/aFa7sLc3Y1F3bc6eQy5os02"
STRIPE_PAYMENT_LINK_PARTNER="https://buy.stripe.com/bJe00j6JEcjH4NI7o65os03"

# Price IDs Stripe réels associés à chaque offre (nécessaires pour le
# rapprochement webhook et pour le parcours virement). Ne pas inventer : à
# renseigner depuis le Dashboard Stripe (mode test) correspondant aux
# Payment Links ci-dessus.
STRIPE_PRICE_ID_ESSENTIEL=""
STRIPE_PRICE_ID_PILOTAGE=""
STRIPE_PRICE_ID_MAITRISE=""
STRIPE_PRICE_ID_PARTNER=""

# API Sirene INSEE (proxy serveur uniquement, jamais exposée au frontend)
INSEE_API_KEY=""

# Stockage fichiers (S3 compatible)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@preuvia.fr"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PREUVIA DUERP"
