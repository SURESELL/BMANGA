# PlannerVids — environment variables
# Copy to .env.local (dev) and fill in real values. Never commit .env* files.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://plannervids:plannervids@localhost:5432/plannervids"

# --- Auth --------------------------------------------------------------------
# Symmetric secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""
APP_URL="http://localhost:3100"

# --- Encryption ---------------------------------------------------------------
# 32-byte key (base64) used to encrypt social OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=""

# --- Timezone / locale ---------------------------------------------------------
DEFAULT_TIMEZONE="Europe/Paris"

# --- AI providers (all optional — app runs fully in "AI provider not configured"
#     mode with manual workflows when these are empty) -------------------------
TEXT_AI_PROVIDER=""        # e.g. "openai" | "anthropic" — empty = disabled
TEXT_AI_API_KEY=""
IMAGE_AI_PROVIDER=""       # e.g. "openai" | "stability" — empty = disabled
IMAGE_AI_API_KEY=""
TTS_PROVIDER=""            # e.g. "elevenlabs" | "azure" — empty = disabled
TTS_API_KEY=""
VIDEO_PROVIDER="template"  # "template" (FFmpeg/Remotion, default, low-cost) | "external_generative" (opt-in, costly)

# --- Storage (S3-compatible, e.g. Cloudflare R2) -------------------------------
STORAGE_PROVIDER=""        # e.g. "r2" | "s3" — empty = local disk fallback (dev only)
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""

# --- Social connectors (all optional, disabled by feature flag until configured) --
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# --- Cost control --------------------------------------------------------------
AI_MONTHLY_BUDGET_CENTS="2000"   # 20 EUR default hard cap

# --- Feature flags (see lib/feature-flags.ts for defaults) ---------------------
FEATURE_AI_TEXT="false"
FEATURE_AI_IMAGE="false"
FEATURE_AI_TTS="false"
FEATURE_SHORT_FACTORY="true"
FEATURE_LINKEDIN="false"
FEATURE_FACEBOOK="false"
FEATURE_INSTAGRAM="false"
FEATURE_TIKTOK="false"
FEATURE_YOUTUBE="false"
FEATURE_ANALYTICS="true"
FEATURE_AFFILIATE_TRACKING="true"
